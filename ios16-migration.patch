index 0000000..b766aaf
--- /dev/null
+++ b/STV/Compatibility/EpisodePager.swift
@@ -0,0 +1,114 @@
+import SwiftUI
+import UIKit
+
+/// Reusable vertical pages on iOS 16. UICollectionView keeps only nearby episode views alive.
+struct EpisodePager<Content: View>: UIViewControllerRepresentable {
+    let count: Int
+    let selection: Int
+    let enabled: Bool
+    let revision: String
+    let onSelect: (Int) -> Void
+    let onOffset: (CGFloat) -> Void
+    let onSettled: (Bool) -> Void
+    @ViewBuilder let content: (Int) -> Content
+
+    func makeUIViewController(context: Context) -> Controller { Controller(configuration: self) }
+    func updateUIViewController(_ controller: Controller, context: Context) { controller.update(self) }
+
+    final class Controller: UIViewController, UICollectionViewDataSource, UICollectionViewDelegateFlowLayout {
+        var configuration: EpisodePager
+        private let layout = UICollectionViewFlowLayout()
+        private lazy var collection = UICollectionView(frame: .zero, collectionViewLayout: layout)
+        private var pageSize = CGSize.zero
+        private var lastSelection: Int?
+
+        init(configuration: EpisodePager) { self.configuration = configuration; super.init(nibName: nil, bundle: nil) }
+        required init?(coder: NSCoder) { fatalError("init(coder:) has not been implemented") }
+
+        override func viewDidLoad() {
+            super.viewDidLoad()
+            view.backgroundColor = .clear
+            layout.minimumLineSpacing = 0; layout.minimumInteritemSpacing = 0
+            layout.scrollDirection = .vertical
+            collection.backgroundColor = .clear
+            collection.isPagingEnabled = true
+            collection.showsVerticalScrollIndicator = false
+            collection.contentInsetAdjustmentBehavior = .never
+            collection.dataSource = self; collection.delegate = self
+            collection.register(UICollectionViewCell.self, forCellWithReuseIdentifier: "episode")
+            view.addSubview(collection)
+            collection.autoresizingMask = [.flexibleWidth, .flexibleHeight]
+            collection.frame = view.bounds
+            collection.isScrollEnabled = configuration.enabled
+        }
+
+        override func viewDidLayoutSubviews() {
+            super.viewDidLayoutSubviews()
+            guard view.bounds.width > 0, view.bounds.height > 0 else { return }
+            if pageSize != view.bounds.size {
+                pageSize = view.bounds.size
+                layout.itemSize = pageSize
+                layout.invalidateLayout()
+                collection.layoutIfNeeded()
+                position(configuration.selection)
+            }
+        }
+
+        func update(_ new: EpisodePager) {
+            let countChanged = configuration.count != new.count
+            let contentChanged = countChanged || configuration.revision != new.revision
+            configuration = new
+            guard isViewLoaded else { return }
+            collection.isScrollEnabled = new.enabled
+            if countChanged { collection.reloadData() }
+            if contentChanged {
+                for index in collection.indexPathsForVisibleItems where index.item < new.count {
+                    if let cell = collection.cellForItem(at: index) { configure(cell, index.item) }
+                }
+            }
+            if !collection.isDragging && !collection.isDecelerating && lastSelection != new.selection {
+                position(new.selection)
+            }
+        }
+
+        private func position(_ index: Int) {
+            guard configuration.count > 0, pageSize.height > 0 else { return }
+            let index = min(max(0, index), configuration.count - 1)
+            lastSelection = index
+            collection.setContentOffset(CGPoint(x: 0, y: CGFloat(index) * pageSize.height), animated: false)
+            publishOffset()
+        }
+
+        func collectionView(_ collectionView: UICollectionView, numberOfItemsInSection section: Int) -> Int { configuration.count }
+        func collectionView(_ collectionView: UICollectionView, cellForItemAt indexPath: IndexPath) -> UICollectionViewCell {
+            let cell = collectionView.dequeueReusableCell(withReuseIdentifier: "episode", for: indexPath)
+            configure(cell, indexPath.item)
+            return cell
+        }
+        private func configure(_ cell: UICollectionViewCell, _ index: Int) {
+            cell.backgroundColor = .clear
+            let content = configuration.content
+            cell.contentConfiguration = UIHostingConfiguration { content(index) }.margins(.all, 0)
+        }
+        private func publishOffset() {
+            let offset = collection.contentOffset.y
+            let notify = configuration.onOffset
+            DispatchQueue.main.async { notify(offset) }
+        }
+        func scrollViewDidScroll(_ scrollView: UIScrollView) { publishOffset() }
+        func scrollViewWillBeginDragging(_ scrollView: UIScrollView) {
+            configuration.onSettled(false)
+        }
+        func scrollViewDidEndDragging(_ scrollView: UIScrollView, willDecelerate decelerate: Bool) {
+            if !decelerate { finishScroll() }
+        }
+        func scrollViewDidEndDecelerating(_ scrollView: UIScrollView) { finishScroll() }
+        private func finishScroll() {
+            guard pageSize.height > 0, configuration.count > 0 else { return }
+            let index = min(configuration.count - 1, max(0, Int((collection.contentOffset.y / pageSize.height).rounded())))
+            lastSelection = index
+            if index != configuration.selection { configuration.onSelect(index) }
+            configuration.onSettled(true)
+        }
+    }
+}
diff --git a/STV/Compatibility/IOS16Views.swift b/STV/Compatibility/IOS16Views.swift
new file mode 100644
index 0000000..418c0f7
--- /dev/null
+++ b/STV/Compatibility/IOS16Views.swift
@@ -0,0 +1,161 @@
+import SwiftUI
+import UIKit
+
+/// Keep the old/new-value semantics used by the app on iOS 16.
+private struct ChangeObserver<Value: Equatable>: ViewModifier {
+    let value: Value
+    let initial: Bool
+    let action: (Value, Value) -> Void
+    @State private var previous: Value
+    @State private var appeared = false
+
+    init(value: Value, initial: Bool, action: @escaping (Value, Value) -> Void) {
+        self.value = value; self.initial = initial; self.action = action
+        _previous = State(initialValue: value)
+    }
+
+    func body(content: Content) -> some View {
+        content.onAppear {
+            guard !appeared else { return }
+            appeared = true
+            previous = value
+            if initial { action(value, value) }
+        }.onChange(of: value) { next in
+            let old = previous
+            previous = next
+            action(old, next)
+        }
+    }
+}
+
+extension View {
+    func onChangeCompat<V: Equatable>(of value: V, initial: Bool = false, _ action: @escaping (V, V) -> Void) -> some View {
+        modifier(ChangeObserver(value: value, initial: initial, action: action))
+    }
+    func onChangeCompat<V: Equatable>(of value: V, _ action: @escaping () -> Void) -> some View {
+        onChangeCompat(of: value) { _, _ in action() }
+    }
+    @ViewBuilder func presentationBackgroundCompat(_ color: Color) -> some View {
+        if #available(iOS 16.4, *) { presentationBackground(color) }
+        else { background(color) }
+    }
+    @ViewBuilder func presentationCornerRadiusCompat(_ radius: CGFloat) -> some View {
+        if #available(iOS 16.4, *) { presentationCornerRadius(radius) }
+        else { self }
+    }
+    @ViewBuilder func defaultScrollAnchorCompat(_ anchor: UnitPoint?) -> some View {
+        if #available(iOS 17.0, *) { defaultScrollAnchor(anchor) }
+        else { self }
+    }
+    @ViewBuilder func scrollBounceBasedOnSize(axes: Axis.Set = .vertical) -> some View {
+        if #available(iOS 16.4, *) { scrollBounceBehavior(.basedOnSize, axes: axes) }
+        else { self }
+    }
+}
+
+struct UnavailableStateView<Title: View, Detail: View, Actions: View>: View {
+    let title: Title
+    let detail: Detail
+    let actions: Actions
+    init(@ViewBuilder label: () -> Title, @ViewBuilder description: () -> Detail, @ViewBuilder actions: () -> Actions) {
+        title = label(); detail = description(); self.actions = actions()
+    }
+    var body: some View {
+        VStack(spacing: 14) {
+            title.font(.title3.weight(.semibold))
+            detail.font(.subheadline).foregroundStyle(.secondary).multilineTextAlignment(.center)
+            actions
+        }.padding(24).frame(maxWidth: .infinity, maxHeight: .infinity)
+    }
+}
+
+extension UnavailableStateView where Title == Label<Text, Image>, Detail == Text?, Actions == EmptyView {
+    init(_ title: String, systemImage: String, description: Text? = nil) {
+        self.title = Label(title, systemImage: systemImage)
+        detail = description; actions = EmptyView()
+    }
+    static func search(text: String) -> Self {
+        Self("没有搜索结果", systemImage: "magnifyingglass", description: Text("未找到与“\(text)”匹配的内容"))
+    }
+}
+
+/// Unequal corner radii without the iOS 17 UnevenRoundedRectangle type.
+struct CornerRectangle: Shape {
+    var topLeadingRadius: CGFloat = 0
+    var bottomLeadingRadius: CGFloat = 0
+    var bottomTrailingRadius: CGFloat = 0
+    var topTrailingRadius: CGFloat = 0
+    var style: RoundedCornerStyle = .continuous
+    func path(in rect: CGRect) -> Path {
+        let limit = min(rect.width, rect.height) / 2
+        let tl = min(limit, max(0, topLeadingRadius)), tr = min(limit, max(0, topTrailingRadius))
+        let bl = min(limit, max(0, bottomLeadingRadius)), br = min(limit, max(0, bottomTrailingRadius))
+        var p = Path()
+        p.move(to: CGPoint(x: rect.minX + tl, y: rect.minY))
+        p.addLine(to: CGPoint(x: rect.maxX - tr, y: rect.minY))
+        p.addQuadCurve(to: CGPoint(x: rect.maxX, y: rect.minY + tr), control: CGPoint(x: rect.maxX, y: rect.minY))
+        p.addLine(to: CGPoint(x: rect.maxX, y: rect.maxY - br))
+        p.addQuadCurve(to: CGPoint(x: rect.maxX - br, y: rect.maxY), control: CGPoint(x: rect.maxX, y: rect.maxY))
+        p.addLine(to: CGPoint(x: rect.minX + bl, y: rect.maxY))
+        p.addQuadCurve(to: CGPoint(x: rect.minX, y: rect.maxY - bl), control: CGPoint(x: rect.minX, y: rect.maxY))
+        p.addLine(to: CGPoint(x: rect.minX, y: rect.minY + tl))
+        p.addQuadCurve(to: CGPoint(x: rect.minX + tl, y: rect.minY), control: CGPoint(x: rect.minX, y: rect.minY))
+        p.closeSubpath()
+        return p
+    }
+}
+
+private struct ScrollOffsetKey: PreferenceKey {
+    static var defaultValue: CGFloat = 0
+    static func reduce(value: inout CGFloat, nextValue: () -> CGFloat) { value = nextValue() }
+}
+
+/// Measures content in its own scroll viewport; supports refreshable and ScrollViewReader.
+struct OffsetScrollView<Content: View>: View {
+    var onOffsetChange: (CGFloat) -> Void
+    @ViewBuilder var content: () -> Content
+    @State private var coordinateID = UUID()
+    var body: some View {
+        ScrollView {
+            content().background {
+                GeometryReader { geometry in
+                    Color.clear.preference(key: ScrollOffsetKey.self, value: -geometry.frame(in: .named(coordinateID)).minY)
+                }
+            }
+        }
+        .coordinateSpace(name: coordinateID)
+        .onPreferenceChange(ScrollOffsetKey.self, perform: onOffsetChange)
+    }
+}
+
+
+@MainActor
+private enum SwitchFeedback {
+    static var lastImpact = -Double.infinity
+
+    static func impact(_ style: UIImpactFeedbackGenerator.FeedbackStyle) {
+        let now = ProcessInfo.processInfo.systemUptime
+        guard now - lastImpact >= 0.15 else { return }
+        lastImpact = now
+        UIImpactFeedbackGenerator(style: style).impactOccurred()
+    }
+}
+
+extension Binding where Value: Equatable {
+    @MainActor
+    private func withFeedback(_ style: @escaping (Value) -> UIImpactFeedbackGenerator.FeedbackStyle) -> Binding<Value> {
+        Binding(get: { wrappedValue }, set: { value, transaction in
+            guard wrappedValue != value else { return }
+            self.transaction(transaction).wrappedValue = value
+            SwitchFeedback.impact(style(value))
+        })
+    }
+
+    @MainActor
+    func withSelectionFeedback() -> Binding<Value> { withFeedback { _ in .light } }
+
+    @MainActor
+    func withSwitchFeedback() -> Binding<Value> where Value == Bool {
+        withFeedback { $0 ? .medium : .light }
+    }
+}
