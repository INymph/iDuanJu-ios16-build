new file mode 100644
index 0000000..f3289e7
--- /dev/null
+++ b/scripts/test-package-validation.py
@@ -0,0 +1,56 @@
+import importlib.util
+import plistlib
+import struct
+import tempfile
+import unittest
+from pathlib import Path
+
+spec = importlib.util.spec_from_file_location('validator', Path(__file__).with_name('verify-ios16-package.py'))
+validator = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(validator)
+
+def binary(ios=16, platform=2, encrypted=False, dependency=None):
+    commands = [struct.pack('<IIIIII', 0x32, 24, platform, ios << 16, 18 << 16, 0)]
+    if encrypted:
+        commands.append(struct.pack('<IIIIII', 0x2c, 24, 0, 0, 1, 0))
+    if dependency:
+        name = dependency.encode() + b'\0'
+        commands.append(struct.pack('<IIIIII', 0xc, 24 + len(name), 24, 0, 0, 0) + name)
+    return struct.pack('<IIIIIIII', 0xfeedfacf, validator.ARM64, 0, 2, len(commands), sum(map(len, commands)), 0, 0) + b''.join(commands)
+
+class PackageValidationTests(unittest.TestCase):
+    def test_accepts_ios16_binary_built_with_newer_sdk(self):
+        self.assertEqual(validator.inspect_macho(binary(), 'STV')[0]['minimum_ios'], '16.0.0')
+
+    def test_rejects_ios18_minimum(self):
+        with self.assertRaisesRegex(ValueError, 'minimum iOS'):
+            validator.inspect_macho(binary(ios=18), 'STV')
+
+    def test_rejects_simulator(self):
+        with self.assertRaisesRegex(ValueError, 'not an iOS device'):
+            validator.inspect_macho(binary(platform=7), 'STV')
+
+    def test_rejects_encryption(self):
+        with self.assertRaisesRegex(ValueError, 'encrypted'):
+            validator.inspect_macho(binary(encrypted=True), 'STV')
+
+    def test_rejects_old_engine_dependency(self):
+        with self.assertRaisesRegex(ValueError, 'removed engine'):
+            validator.inspect_macho(binary(dependency='@rpath/AetherLibavcodec.framework/AetherLibavcodec'), 'STV')
+
+    def test_checks_embedded_frameworks(self):
+        with tempfile.TemporaryDirectory() as temporary:
+            app = Path(temporary) / 'STV.app'
+            app.mkdir()
+            (app / 'Info.plist').write_bytes(plistlib.dumps({'MinimumOSVersion': '16.0', 'CFBundleSupportedPlatforms': ['iPhoneOS'], 'CFBundleExecutable': 'STV', 'CFBundleIdentifier': 'com.local.STV'}))
+            (app / 'STV').write_bytes(binary())
+            framework = app / 'Frameworks/Example.framework'
+            framework.mkdir(parents=True)
+            (framework / 'Example').write_bytes(binary(ios=17))
+            with self.assertRaisesRegex(ValueError, 'minimum iOS'):
+                validator.validate(app)
+            (framework / 'Example').write_bytes(binary(ios=12))
+            self.assertEqual(len(validator.validate(app)['binaries']), 2)
+
+if __name__ == '__main__':
+    unittest.main()
diff --git a/scripts/verify-ios16-package.py b/scripts/verify-ios16-package.py
new file mode 100644
index 0000000..161e4b7
--- /dev/null
+++ b/scripts/verify-ios16-package.py
@@ -0,0 +1,84 @@
+#!/usr/bin/env python3
+"""Fail packaging if an embedded Mach-O is encrypted, simulator-only, or requires newer iOS."""
+import json
+import plistlib
+import struct
+import sys
+from pathlib import Path
+
+MAX_IOS = (16, 0, 0)
+ARM64 = 0x0100000C
+
+def version(n):
+    return (n >> 16, (n >> 8) & 255, n & 255)
+
+def inspect_macho(data, label):
+    magic = data[:4]
+    if magic in (b'\xca\xfe\xba\xbe', b'\xca\xfe\xba\xbf'):
+        fat64 = magic[-1] == 0xbf
+        count = struct.unpack_from('>I', data, 4)[0]
+        slices = []
+        for i in range(count):
+            entry = 8 + i * (32 if fat64 else 20)
+            cpu = struct.unpack_from('>I', data, entry)[0]
+            offset, size = struct.unpack_from('>QQ' if fat64 else '>II', data, entry + 8)
+            if cpu == ARM64:
+                slices += inspect_macho(data[offset:offset + size], label)
+        if not slices:
+            raise ValueError(f'{label}: no arm64 device slice')
+        return slices
+    if magic not in (b'\xcf\xfa\xed\xfe', b'\xce\xfa\xed\xfe'):
+        return []
+    cpu, _, _, ncmds = struct.unpack_from('<IIII', data, 4)
+    if cpu != ARM64:
+        raise ValueError(f'{label}: architecture is not arm64')
+    offset = 32 if magic[0] == 0xcf else 28
+    minimum = None
+    dependencies = []
+    for _ in range(ncmds):
+        cmd, size = struct.unpack_from('<II', data, offset)
+        if size < 8 or offset + size > len(data):
+            raise ValueError(f'{label}: invalid Mach-O command')
+        if cmd == 0x32:  # LC_BUILD_VERSION
+            platform, packed = struct.unpack_from('<II', data, offset + 8)
+            if platform != 2:
+                raise ValueError(f'{label}: platform {platform} is not an iOS device')
+            minimum = version(packed)
+        elif cmd == 0x25:  # LC_VERSION_MIN_IPHONEOS
+            minimum = version(struct.unpack_from('<I', data, offset + 8)[0])
+        elif cmd in (0x21, 0x2C):  # LC_ENCRYPTION_INFO[_64]
+            if struct.unpack_from('<I', data, offset + 16)[0]:
+                raise ValueError(f'{label}: encrypted executable')
+        elif cmd in (0xC, 0x80000018, 0x8000001F, 0x20, 0x80000023):
+            start = offset + struct.unpack_from('<I', data, offset + 8)[0]
+            name = data[start:offset + size].split(b'\0')[0].decode('utf-8')
+            dependencies.append(name)
+            if any(term in name.lower() for term in ('aether', 'libavcodec', 'libavformat')):
+                raise ValueError(f'{label}: removed engine dependency {name}')
+        offset += size
+    if minimum is None or minimum > MAX_IOS:
+        raise ValueError(f'{label}: minimum iOS {minimum}, expected <= {MAX_IOS}')
+    return [{'file': label, 'arch': 'arm64', 'minimum_ios': '.'.join(map(str, minimum)), 'dependencies': dependencies}]
+
+def validate(app):
+    info = plistlib.loads((app / 'Info.plist').read_bytes())
+    minimum = tuple(int(n) for n in info['MinimumOSVersion'].split('.'))
+    if minimum + (0,) * (3 - len(minimum)) > MAX_IOS:
+        raise ValueError('Info.plist requires newer than iOS 16.0')
+    if info.get('CFBundleSupportedPlatforms') != ['iPhoneOS']:
+        raise ValueError('Not an iPhoneOS device application')
+    executable = app / info['CFBundleExecutable']
+    main = inspect_macho(executable.read_bytes(), executable.name)
+    if not main:
+        raise ValueError('App executable is not Mach-O')
+    binaries = list(main)
+    for p in app.rglob('*'):
+        if p.is_file() and p != executable:
+            with p.open('rb') as f:
+                magic = f.read(4)
+            if magic in (b'\xcf\xfa\xed\xfe', b'\xce\xfa\xed\xfe', b'\xca\xfe\xba\xbe', b'\xca\xfe\xba\xbf'):
+                binaries.extend(inspect_macho(p.read_bytes(), str(p.relative_to(app))))
+    return {'bundle_id': info['CFBundleIdentifier'], 'minimum_ios': info['MinimumOSVersion'], 'binaries': binaries}
+
+if __name__ == '__main__':
+    print(json.dumps(validate(Path(sys.argv[1])), indent=2))
